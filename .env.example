# ==============================================================================
# Serverless ETL Pipeline - Environment Configuration Template
# Copy this file to '.env' and populate with your configuration.
# NOTE: DO NOT commit your actual '.env' file to source control.
# AWS credentials should ideally come from AWS CLI profile or IAM role.
# ==============================================================================

# AWS Environment Settings
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=my-etl-pipeline-data-2026-unique

# S3 Prefix Hierarchy (Must end with '/')
S3_INPUT_PREFIX=input/
S3_OUTPUT_ACCEPTED_PREFIX=output/accepted/
S3_OUTPUT_REJECTED_PREFIX=output/rejected/
S3_OUTPUT_REPORTS_PREFIX=output/reports/

# AWS Authentication
# Option 1: Standard Access Keys (useful for local testing)
# AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# AWS_SESSION_TOKEN=replace-if-using-temporary-session-token

# Option 2: AWS Profile Name (if using ~/.aws/credentials via aws configure)
# Leave blank to use default AWS credential provider chain
AWS_PROFILE=

# Pipeline Processing Settings
LOCAL_INPUT_DIR=sample_data
LOCAL_OUTPUT_DIR=output
DEFAULT_OUTPUT_FORMAT=json

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
